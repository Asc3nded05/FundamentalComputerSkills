        },
        "Narrator": {
            "eventOn": "AccessibilityNarratorOn",
            "eventOff": "AccessibilityNarratorOff",
            "description": "Your built-in screen reader"
        },
        "Color Filters": {
            "eventOn": "AccessibilityColorFiltersOn",
            "eventOff": "AccessibilityColorFiltersOff",
            "description": "Distinguish among colors easily"
        },
        "Live Captions": {
            "eventOn": "AccessibilityLiveCaptionsOn",
            "eventOff": "AccessibilityLiveCaptionsOff",
            "description": "Real time audio transcription"
        },
        "Mono Audio": {
            "eventOn": "AccessibilityMonoAudioOn",
            "eventOff": "AccessibilityMonoAudioOff",
            "description": "Combine left and right audio channels"
        },
        "Voice Access": {
            "eventOn": "AccessibilityVoiceAccessOn",
            "eventOff": "AccessibilityVoiceAccessOff",
            "description": "Interact with your PC using voice"
        },
        "Sticky Keys": {
            "eventOn": "AccessibilityStickyKeysOn",
            "eventOff": "AccessibilityStickyKeysOff",
            "description": "Use shortcuts one key at a time"
        }
